# Template: deploy/install.sh fills in @USER@ and @REPO@ and installs it as /etc/systemd/system/x4tags.service.
[Unit]
Description=x4tags: AprilTags from an Insta360 X4 360-degree webcam stream
# Don't wait for the network: the NetworkTables client keeps retrying until the robot is up.
# Never stop restarting, however often it fails.
StartLimitIntervalSec=0

[Service]
User=@USER@
SupplementaryGroups=video
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv/bin/x4tags --config /etc/x4tags.toml
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1
# Keep NumPy's BLAS from starting its own thread pool (x4tags limits OpenCV's itself; NAPA's threads come from
# [detector] threads).
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
Nice=-5

[Install]
WantedBy=multi-user.target

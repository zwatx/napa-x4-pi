# Template: deploy/install.sh fills in @USER@ and @REPO@ and installs it as /etc/systemd/system/x4tags.service.
[Unit]
Description=x4tags: AprilTags from an Insta360 X4 360-degree webcam stream
# Don't wait for the network: the NetworkTables client keeps retrying until the robot is up.
# Never stop restarting, however often it fails.
StartLimitIntervalSec=0

[Service]
User=@USER@
SupplementaryGroups=video
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv/bin/x4tags --config /etc/x4tags.toml
# x4tags tells systemd when it's running, and pings it every second (also while it waits for the camera): if it
# hangs for 15 s it is restarted.
Type=notify
NotifyAccess=main
WatchdogSec=15
TimeoutStopSec=10
Restart=always
# Back off to 30 s for failures that persist (a bad /etc/x4tags.toml exits with 78), so a fixed file is picked up.
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
Environment=PYTHONUNBUFFERED=1
# Keep NumPy's BLAS from starting its own thread pool (x4tags limits OpenCV's itself; NAPA's threads come from
# [detector] threads). Keep OpenCV's own V4L2 warnings out of the journal, and a stalled camera read short.
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 OPENCV_LOG_LEVEL=ERROR OPENCV_VIDEOIO_V4L_SELECT_TIMEOUT=2
Nice=-5
# It uses about 100 MB; this catches a leak. Raspberry Pi OS leaves the memory cgroup off, which makes it a no-op
# there: add cgroup_enable=memory to /boot/firmware/cmdline.txt to have it.
MemoryMax=400M
# It reads the camera, /etc/x4tags.toml and the field layout, and talks over the network; nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
DevicePolicy=closed
DeviceAllow=char-video4linux rw
UMask=0077

[Install]
WantedBy=multi-user.target
